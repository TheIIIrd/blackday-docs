{
  // Длина строки не ограничивается: русский текст и таблицы всё равно длиннее 80.
  "MD013": false,
  // Разрешаем HTML-вставки (например, <br> в таблицах).
  "MD033": false,
  // Разрешаем одинаковые заголовки в разных разделах (например, «Проверка»).
  "MD024": { "siblings_only": true },
  // Первая строка файла — заголовок.
  "MD041": true,
  // Разделители таблиц пишем компактно (|---|---|), без выравнивания пробелами.
  // Правило появилось в новых версиях линтера; в CI закреплена более старая.
  "MD060": false
}
